# ---- Derived geodata: regenerated by the pipeline ----
# Binary geodata churns badly in git. Raw inputs are tracked; processed is not.
projects/*/data/processed/
projects/*/data/interim/
projects/*/outputs/
*.gpkg
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.sbn
*.sbx
*.tif
*.tiff
*.gdb/
*.lock

# Exception: keep small canonical raw geodata
!projects/*/data/raw/*.geojson

# ---- ArcGIS ----
*.aprx
*.mxd
*.tbx
*.atbx
Index/
scratch.gdb/

# ---- Licence-restricted inputs (see docs/DATA_PROVENANCE.md) ----
# worldcities.csv was cleared: 41,002 rows identifies it as the SimpleMaps Basic
# edition (CC BY 4.0, redistributable with attribution), so it is tracked.
# cuisine_ingredient_matrix.csv provenance is still unresolved, but the repo is
# private, so it stays tracked rather than excluded — revisit before going public.

# ---- Superseded package versions, kept locally for provenance only ----
archive/

# ---- Large media ----
*.mp4
*.mov
*.zip
*.7z

# ---- Secrets ----
.env
.env.*
*.key
*.pem
secrets.*
.codex/
